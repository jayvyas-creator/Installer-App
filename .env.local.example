# Copy to .env.local. Read by Vite at dev-server start / build time only —
# changing it while `npm run dev` is running has no effect until restarted.

# true = click through the whole flow offline with mock data, no backend or
# credentials needed (src/api/mocks/realEndpoints.ts). false = call the real
# EVES API through the server/ proxy (see server/.env.example for its setup).
VITE_USE_MOCKS=true

# Base path the front end calls for backend requests. The dev server proxies
# this to the server/ proxy (see vite.config.ts); in production the built
# SPA and the proxy are served from the same origin, so the default is fine.
VITE_API_BASE_URL=/api
