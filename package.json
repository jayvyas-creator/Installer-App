{
  "name": "standalone-web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc -b && vite build && tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "@radix-ui/react-radio-group": "^1.5.0",
    "@radix-ui/react-slot": "^1.5.0",
    "express": "^5.1.0",
    "i18next": "^26.5.2",
    "lucide-react": "^1.54.0",
    "motion": "^14.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.1.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tempo-sdk": "^0.0.52",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^28.1.0",
    "oxlint": "^1.81.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
